---
import BaseLayout from '../layouts/BaseLayout.astro';
import { NEWS } from '../data/news';

// '2026-10' -> 'Oct 2026'; anything else is shown as written.
const when = (d: string) =>
  /^\d{4}-\d{2}$/.test(d)
    ? new Date(`${d}-01T00:00:00Z`).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })
    : d;
---
<BaseLayout title="News" description="Recent updates from James Belanger.">
  <h1 class="text-3xl font-bold tracking-tight">News</h1>
  <ul class="mt-8 space-y-5">
    {
      NEWS.map((n) => (
        <li class="flex gap-4">
          <time datetime={n.date} class="w-20 shrink-0 pt-0.5 font-mono text-sm text-muted">{when(n.date)}</time>
          <p class="leading-relaxed">
            {n.href ? <a href={n.href} class="no-underline hover:underline">{n.text}</a> : n.text}
          </p>
        </li>
      ))
    }
  </ul>
</BaseLayout>
