---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROJECTS } from '../data/projects';
import Tag from '../components/Tag.astro';

const categories = ['Research engineering', 'Product / full-stack'] as const;
const heading = { 'Product / full-stack': 'Personal projects', 'Research engineering': 'Lab work' } as const;
---
<BaseLayout title="Projects" description="Projects by James Belanger: research software from his lab work, and a few tools you can try.">
  <h1 class="text-3xl font-bold tracking-tight">Projects</h1>
  <p class="mt-3 max-w-2xl text-lg leading-relaxed text-muted">
    The research software from my lab work, then a few personal projects you can try.
  </p>

  {
    categories.map((cat) => (
      <section class="mt-10">
        <h2 class="label">{heading[cat]}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2">
          {PROJECTS.filter((p) => p.category === cat).map((p) => (
            <article class="clip flex flex-col p-5">
              <h3 class="text-base font-semibold leading-snug">{p.name}</h3>
              <p class="mt-2 flex-1 text-sm leading-relaxed text-muted">{p.blurb}</p>
              <div class="mt-3 flex flex-wrap gap-1.5">
                {p.stack.map((s) => (
                  <Tag label={s} />
                ))}
              </div>
              {p.links && (
                <div class="mt-3 flex flex-wrap gap-x-4 text-sm">
                  {p.links.map((l) => (
                    <a href={l.href}>{l.label} →</a>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      </section>
    ))
  }
</BaseLayout>
