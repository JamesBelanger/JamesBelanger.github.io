---
// The name, two more ways: IPA with a play button, and a slow cycle through
// the scripts James reads, each of which can be played in a native voice.
// Data lives in src/data/site.ts (ipa, nameScripts).
//
// Audio: public/audio/name-<lang>.mp3, generated by scripts/make-name-audio.py.
// A script with no clip simply gets no play button. public/audio/name.mp3 (James's
// own recording), if present, replaces the English clip; with neither, the English
// button falls back to the browser's speech synthesis.
//
// The cycle pauses on hover/focus and while a clip plays, advances on click, and is
// static under prefers-reduced-motion (click still advances). Anything else on the
// page can ask for a language with a `name:say` event (detail.lang) — the collage's
// name chips do.
import { existsSync } from 'node:fs';
import { SITE } from '../data/site';

const clip = (file: string) => (existsSync(`public/audio/${file}`) ? `/audio/${file}` : undefined);
const english = clip('name.mp3') ?? clip('name-en.mp3');
const scripts = SITE.nameScripts.map((s) => ({ ...s, src: clip(`name-${s.lang}.mp3`) }));
---
<div class="name-scripts mt-3 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-muted" data-name-scripts>
  <span class="flex items-center gap-2">
    <span class="font-mono text-sm" lang="en-fonipa">{SITE.ipa}</span>
    <button type="button" class="play" data-play="en" data-src={english} data-say={SITE.name} aria-label={`Hear “${SITE.name}” in English`}>
      <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 1.2v9.6L10.5 6z" /></svg>
    </button>
  </span>

  <span class="flex items-center gap-2">
    <button
      type="button"
      data-cycle
      class="script-cycle grid cursor-pointer text-left text-base text-fg"
      aria-label={`${SITE.name} written in ${scripts.length} scripts. Click to see the next one.`}
    >
      {
        scripts.map((s, i) => (
          <span data-script data-lang={s.lang} data-label={s.label} data-src={s.src} class:list={['script', { 'is-on': i === 0 }]} aria-hidden="true">
            <span lang={s.lang} dir={s.rtl ? 'rtl' : 'ltr'}>{s.text}</span>
            <span class="ml-2 font-mono text-[11px] uppercase tracking-wider text-muted">{s.label}</span>
          </span>
        ))
      }
    </button>
    <button type="button" class="play" data-play="current" aria-label={`Hear it in ${scripts[0].label}`}>
      <svg viewBox="0 0 12 12" fill="currentColor" aria-hidden="true"><path d="M2 1.2v9.6L10.5 6z" /></svg>
    </button>
  </span>
</div>

<style>
  /* All scripts share one grid cell, so the line never changes width as it cycles. */
  .script {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.25em);
    transition: opacity 0.5s ease, transform 0.5s ease;
    white-space: nowrap;
  }
  .script.is-on {
    opacity: 1;
    transform: none;
  }
  .play {
    display: grid;
    place-items: center;
    width: 1.6rem;
    height: 1.6rem;
    flex: none;
    border: 1.5px solid var(--fg);
    border-radius: 50%;
    color: var(--fg);
    transition: background-color 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .play svg {
    width: 0.6rem;
    height: 0.6rem;
    translate: 1px 0;
  }
  .play:hover,
  .play.is-playing {
    background: var(--pop);
    color: #141418;
    border-color: #141418;
  }
  .play.is-playing {
    transform: scale(1.12);
  }
  .play[hidden] {
    display: none;
  }
</style>

<script>
  const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('[data-name-scripts]');

  if (root) {
    const cycle = root.querySelector<HTMLButtonElement>('[data-cycle]')!;
    const items = Array.from(cycle.querySelectorAll<HTMLElement>('[data-script]'));
    const playEn = root.querySelector<HTMLButtonElement>('[data-play="en"]')!;
    const playCur = root.querySelector<HTMLButtonElement>('[data-play="current"]')!;
    let i = 0;
    let hovering = false;
    let speaking = false;
    let audio: HTMLAudioElement | null = null;

    const show = (n: number) => {
      items[i].classList.remove('is-on');
      i = (n + items.length) % items.length;
      items[i].classList.add('is-on');
      playCur.hidden = !items[i].dataset.src;
      playCur.setAttribute('aria-label', `Hear it in ${items[i].dataset.label}`);
    };
    show(0);

    cycle.addEventListener('click', () => show(i + 1));
    for (const [on, off] of [['mouseenter', 'mouseleave'], ['focusin', 'focusout']]) {
      root.addEventListener(on, () => (hovering = true));
      root.addEventListener(off, () => (hovering = false));
    }
    if (!RM) setInterval(() => !hovering && !speaking && !document.hidden && show(i + 1), 2600);

    // One clip at a time; the cycle holds on a language while it is being spoken.
    const play = (src: string, btn: HTMLElement) => {
      audio?.pause();
      root.querySelectorAll('.is-playing').forEach((b) => b.classList.remove('is-playing'));
      const a = (audio = new Audio(src));
      const done = () => {
        if (audio !== a) return;
        btn.classList.remove('is-playing');
        setTimeout(() => audio === a && (speaking = false), 900);
      };
      speaking = true;
      btn.classList.add('is-playing');
      a.addEventListener('ended', done);
      a.addEventListener('error', done);
      a.play().catch(done);
    };

    const sayEnglish = () => {
      const src = playEn.dataset.src;
      if (src) return play(src, playEn);
      if (!('speechSynthesis' in window)) return;
      speechSynthesis.cancel();
      const u = new SpeechSynthesisUtterance(playEn.dataset.say);
      u.lang = 'en-US';
      u.rate = 0.9;
      speechSynthesis.speak(u);
    };
    const say = (lang: string) => {
      const n = items.findIndex((el) => el.dataset.lang === lang);
      if (n < 0) return sayEnglish();
      show(n);
      const src = items[n].dataset.src;
      if (src) play(src, playCur);
    };

    playEn.addEventListener('click', sayEnglish);
    playCur.addEventListener('click', () => say(items[i].dataset.lang!));
    document.addEventListener('name:say', (e) => say((e as CustomEvent<{ lang: string }>).detail.lang));
  }
</script>
