---
// The experiment, animated: one square per recorded neuron (1,008 of them), firing
// as a sentence goes by one word at a time.
//
// It is an ILLUSTRATION of the recording, not data: which squares light for which
// word is a fixed pseudo-random pattern, and the caption says so. The only real
// number in it is the count of squares. Vanilla canvas, theme-aware, runs only
// while on screen, and draws a single still frame under prefers-reduced-motion.
interface Props { class?: string }
const { class: className = '' } = Astro.props;
const WORDS = ['the', 'brain', 'turns', 'sound', 'into', 'meaning', 'one', 'word', 'at', 'a', 'time'];
---
<figure class:list={['wall', className]}>
  <div class="clip p-3 sm:p-4">
    <canvas data-wall class="block w-full" aria-hidden="true"></canvas>
    <p class="ticker mt-3 flex flex-wrap gap-x-2 font-mono text-sm sm:text-base" data-ticker aria-hidden="true">
      {WORDS.map((w) => <span>{w}</span>)}
    </p>
  </div>
  <figcaption class="mt-3 font-mono text-xs text-muted">
    One square per recorded neuron: 1,008. The firing pattern is an illustration of the experiment, not data.
  </figcaption>
</figure>

<style>
  .ticker span {
    color: var(--muted);
    opacity: 0.45;
    transition: opacity 0.2s ease, color 0.2s ease, background-color 0.2s ease;
    padding: 0 0.15em;
  }
  .ticker span.heard {
    opacity: 1;
  }
  .ticker span.now {
    opacity: 1;
    color: #141418;
    background: var(--pop);
  }
</style>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-wall]');
  const ticker = document.querySelector<HTMLElement>('[data-ticker]');

  if (canvas && ticker) {
    const ctx = canvas.getContext('2d')!;
    const words = Array.from(ticker.children) as HTMLElement[];
    const RM = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const N = 1008;
    const WORD_MS = 560;
    const level = new Float32Array(N); // how lit each neuron is, 0..1
    let cols = 56;
    let rows = 18;
    let cell = 0;
    let colors = { on: '', hot: '', off: '' };
    let word = -1;
    let nextWord = 0;
    let last = 0;
    let visible = false;
    let running = false;

    // Fixed pseudo-random response of neuron n to word w, 0..1.
    const resp = (n: number, w: number) => {
      const x = Math.sin(n * 127.1 + w * 311.7 + 4.2) * 43758.5453;
      return x - Math.floor(x);
    };

    const layout = () => {
      const width = canvas.clientWidth;
      cols = width < 480 ? 36 : 56;
      rows = Math.ceil(N / cols);
      cell = width / cols;
      const dpr = Math.min(2, window.devicePixelRatio || 1);
      canvas.style.height = `${cell * rows}px`;
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(cell * rows * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };
    const readColors = () => {
      const cs = getComputedStyle(document.documentElement);
      colors = {
        on: cs.getPropertyValue('--accent').trim(),
        hot: cs.getPropertyValue('--pop').trim(),
        off: cs.getPropertyValue('--line').trim(),
      };
    };

    const hear = (w: number) => {
      word = w;
      words.forEach((el, i) => {
        el.classList.toggle('now', i === w);
        el.classList.toggle('heard', i < w);
      });
      for (let n = 0; n < N; n++) {
        const r = resp(n, w);
        if (r > 0.9) level[n] = Math.max(level[n], 0.6 + (r - 0.9) * 4);
      }
    };

    const draw = () => {
      ctx.clearRect(0, 0, canvas.clientWidth, canvas.clientHeight);
      const pad = Math.max(0.6, cell * 0.14);
      for (let n = 0; n < N; n++) {
        const x = (n % cols) * cell + pad;
        const y = Math.floor(n / cols) * cell + pad;
        const s = cell - pad * 2;
        const v = level[n];
        if (v < 0.04) {
          ctx.globalAlpha = 1;
          ctx.fillStyle = colors.off;
        } else {
          ctx.globalAlpha = Math.min(1, 0.25 + v * 0.75);
          ctx.fillStyle = v > 0.92 ? colors.hot : colors.on;
        }
        ctx.fillRect(x, y, s, s);
      }
      ctx.globalAlpha = 1;
    };

    const frame = (now: number) => {
      if (!visible) {
        running = false;
        return;
      }
      const dt = Math.min(60, now - (last || now));
      last = now;
      if (now >= nextWord) {
        hear((word + 1) % words.length);
        // a breath at the end of the sentence
        nextWord = now + (word === words.length - 1 ? WORD_MS * 2.6 : WORD_MS);
      }
      const decay = Math.exp(-dt / 270);
      for (let n = 0; n < N; n++) {
        level[n] *= decay;
        if (Math.random() < 0.00045 * dt) level[n] = Math.max(level[n], 0.3 + Math.random() * 0.3); // background firing
      }
      draw();
      requestAnimationFrame(frame);
    };

    layout();
    readColors();
    if (RM) {
      hear(5);
      draw();
    } else {
      draw();
      new IntersectionObserver(([e]) => {
        visible = e.isIntersecting;
        if (visible && !running) {
          running = true;
          last = 0;
          requestAnimationFrame(frame);
        }
      }, { threshold: 0.15 }).observe(canvas);
    }
    window.addEventListener('resize', () => {
      layout();
      draw();
    });
    new MutationObserver(() => {
      readColors();
      draw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
  }
</script>
