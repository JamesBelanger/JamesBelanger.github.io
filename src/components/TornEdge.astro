---
// A torn paper edge in the page colour, pinned to the bottom of its (positioned)
// parent. Seeded, so it's the same tear on every build.
interface Props { seed?: number }
let { seed = 20261005 } = Astro.props;
const rnd = () => ((seed = (seed * 1664525 + 1013904223) >>> 0) / 4294967296);
const tear = Array.from({ length: 81 }, (_, i) => `${(i * 12.5).toFixed(1)},${(3 + rnd() * 11).toFixed(1)}`).join(' ');
---
<svg class="tear" viewBox="0 0 1000 14" preserveAspectRatio="none" aria-hidden="true">
  <polygon points={`0,14 ${tear} 1000,14`} />
</svg>

<style>
  .tear {
    position: absolute;
    left: 0;
    bottom: -1px;
    z-index: 6;
    width: 100%;
    height: 14px;
    fill: var(--bg);
    pointer-events: none;
  }
</style>
