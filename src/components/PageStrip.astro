---
// Header band for inner pages: the bottom slice of the home collage's background
// (halftone teal + the torn colour fields, no name or clippings), so every page
// opens on the same paper. Purely decorative. Same art as CollageHero — see its
// header for how public/collage/ is exported.
import collage from '../../public/collage/layers.json';
import TornEdge from './TornEdge.astro';

const { width: W, height: H, layers } = collage;
const bg = layers[0];
const fields = layers.filter((l) => l.tag === 'field' || l.tag === 'ipa');
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<div class="strip" aria-hidden="true">
  <div class="stage">
    <img class="bg" src={`/collage/${bg.file}`} alt="" width={W} height={H} decoding="async" />
    {
      fields.map((p) => (
        <img
          class="piece"
          src={`/collage/${p.file}`}
          alt=""
          width={p.w}
          height={p.h}
          decoding="async"
          style={`left:${pct(p.cx, W)};top:${pct(p.cy, H)};width:${pct(p.w, W)};--r:${-p.rot}deg`}
        />
      ))
    }
  </div>
  <TornEdge seed={7} />
</div>

<style>
  .strip {
    position: relative;
    height: 4.75rem;
    overflow: hidden;
    background: #0d948e;
  }
  /* Full collage geometry, anchored to the bottom so the strip shows its lowest slice. */
  .stage {
    position: absolute;
    left: 50%;
    bottom: 0;
    width: max(100%, 62rem);
    aspect-ratio: 1584 / 396;
    transform: translateX(-50%);
  }
  .bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .piece {
    position: absolute;
    height: auto;
    transform: translate(-50%, -50%) rotate(var(--r));
    filter: drop-shadow(1px 2px 2px rgb(0 0 0 / 0.28));
  }
</style>
